<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.station.vpnprobe" android:versionCode="2" android:versionName="0.2-relay-lab">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Station local relay lab" android:allowBackup="false"
        android:debuggable="true" android:extractNativeLibs="true" android:usesCleartextTraffic="false">
        <activity android:name=".ProbeActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" />
        <activity android:name=".RelayActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" />
        <service android:name=".ProbeService" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE" android:stopWithTask="true">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
        </service>
        <service android:name=".RelayService" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE" android:stopWithTask="true">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
        </service>
        <service android:name=".MarkerService" android:exported="true" android:permission="android.permission.DUMP" android:stopWithTask="true" />
    </application>
</manifest>
